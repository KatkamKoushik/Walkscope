{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@walking-companion/core/*": [
        "../core/*"
      ],
      "@walking-companion/core": [
        "../core/index.js"
      ]
    }
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "dist",
    ".expo"
  ]
}
